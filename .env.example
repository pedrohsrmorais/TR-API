# Copie para .env só se quiser sobrescrever algum default.
# Sem .env a stack sobe com os valores de desenvolvimento abaixo.

# --- Aplicação -----------------------------------------------------------------
APP_PORTA=3041                 # porta pública (frontend + /api via nginx)
NODE_ENV=production
LOG_NIVEL=info                 # debug | info | warn | error

# --- Autenticação --------------------------------------------------------------
JWT_SEGREDO=dev-troque-este-segredo-em-producao
JWT_EXPIRA_EM=12h

# --- MySQL ---------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_USER=tr_api
MYSQL_PASSWORD=tr_api_dev
MYSQL_PORTA_HOST=3307          # para conectar um client (DBeaver etc.) do seu PC

# --- MinIO (S3 local) ----------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORTA_API=9000
MINIO_PORTA_CONSOLE=9001       # console web: http://localhost:9001

# --- S3 (aponta para o MinIO por padrão; para AWS veja docs/armazenamento.md) --
S3_BUCKET=tr-api-processos
S3_REGIAO=us-east-1
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCAR_PATH_STYLE=true
# S3_CRIAR_BUCKET=true

# --- DJEN (Comunica PJe / CNJ) -------------------------------------------------
DJEN_BASE_URL=https://comunicaapi.pje.jus.br
DJEN_TIMEOUT_MS=20000
DJEN_ITENS_POR_PAGINA=50
DJEN_MAX_PAGINAS=10
DJEN_MOCK=false                # true = usa backend/fixtures/djen/ (sem rede)

# --- Downloads -----------------------------------------------------------------
DOWNLOAD_SEGMENTOS_HABILITADOS=5   # campo J liberado para download (5 = Trabalho)

# --- Worker --------------------------------------------------------------------
WORKER_SIMULACAO=true          # true = gera PDF simulado (testa o fluxo ponta a ponta)
WORKER_INTERVALO_MS=3000
WORKER_HEADLESS=true
WORKER_TIMEOUT_JOB_MS=600000
WORKER_HEARTBEAT_EXPIRA_S=120
